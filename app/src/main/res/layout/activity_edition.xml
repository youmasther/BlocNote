<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fond_principal"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_margin="8dp"
        android:background="#121212">

        <!-- boutons retour/undo/redo/save : inchangés, mais ajoute android:tint
             pour teinter les icônes système en clair -->


        <ImageButton
            android:id="@+id/boutonRetour"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:layout_margin="3dp"
            android:background="@drawable/bouton_rond"
            android:contentDescription="Retour" />

        <!-- ... View spacer inchangé ... -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- même chose pour boutonRedo et boutonSauvegarder : ajoute android:textColor -->
        <ImageButton
            android:id="@+id/boutonUndo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_undo"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:layout_margin="3dp"
            android:background="@drawable/bouton_rond"
            android:contentDescription="Annuler" />

        <ImageButton
            android:id="@+id/boutonRedo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_redo"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:layout_margin="3dp"
            android:background="@drawable/bouton_rond"
            android:contentDescription="Refaire" />

        <ImageButton
            android:id="@+id/boutonSauvegarder"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_save2"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:layout_margin="3dp"
            android:background="@drawable/bouton_rond"
            android:contentDescription="Sauvegarder" />

    </LinearLayout>

    <EditText
        android:id="@+id/editTitre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:hint="Titre"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/texte_principal"
        android:textColorHint="@color/texte_secondaire"
        android:background="@android:color/transparent" />

    <EditText
        android:id="@+id/editContenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:hint="Écrivez votre note ici..."
        android:textSize="16sp"
        android:textColor="@color/texte_principal"
        android:textColorHint="@color/texte_secondaire"
        android:gravity="top"
        android:background="@android:color/transparent"
        android:inputType="textMultiLine" />

</LinearLayout>